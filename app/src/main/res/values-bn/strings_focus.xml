    <string name="focus_a11y_does_block">সিস্টেম-জুড়ে ব্লকিং চালু থাকলে, ব্লক করা অ্যাপ যেখান থেকেই খুলুক (নোটিফিকেশন, সাম্প্রতিক অ্যাপ বা লিংক), বিরতির স্ক্রিন দেখায়।</string>
    <string name="focus_a11y_sees_header">শূন্য কী দেখে</string>
    <string name="focus_a11y_sees_body">শুধু কোন অ্যাপ সামনে এল, ঠিক সেই মুহূর্তে। সেটা আপনার ফোকাসের নিয়মের সাথে মিলিয়ে দেখা হয়, তারপর ভুলে যাওয়া হয়।</string>
    <string name="focus_a11y_never_header">শূন্য যা কখনো করে না</string>
    <string name="focus_a11y_never_read">স্ক্রিনে কী আছে বা আপনি কী লিখছেন, তা কখনো পড়ে না।</string>
    <string name="focus_a11y_never_store">কিছুই রেকর্ড, জমা বা শেয়ার করে না। শূন্যের ইন্টারনেটের অনুমতিই নেই।</string>
    <string name="focus_a11y_never_act">অন্য অ্যাপে কখনো ট্যাপ, টাইপ বা কিছু বদলায় না।</string>
    <string name="focus_a11y_control_header">নিয়ন্ত্রণ আপনার হাতে</string>
    <string name="focus_a11y_without">সার্ভিস ছাড়া ফোকাসের নিয়ম শুধু শূন্য থেকে খোলা অ্যাপে কাজ করে।</string>
    <string name="focus_a11y_steps">সেটিংসে “%1$s” বেছে নিয়ে চালু করুন।</string>
    <string name="focus_a11y_agree">রাজি, সেটিংস খুলুন</string>
