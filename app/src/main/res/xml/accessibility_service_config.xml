<?xml version="1.0" encoding="utf-8"?>
<!--
  Shunya focus (opt-in, shown only after the in-app disclosure).
  Only window-state changes are observed, i.e. which app came to the front; window content is
  never retrieved (canRetrieveWindowContent=false) and no gestures are performed.
  Used for: lock screen on double-tap, system-wide blocking.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/focus_accessibility_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
