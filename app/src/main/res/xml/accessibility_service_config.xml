<?xml version="1.0" encoding="utf-8"?>
<!--
  Shunya focus accessibility service (opt-in).
  Only window-state changes are observed (which app came to the foreground); window
  content is never read. Used for: lock screen on double-tap, system-wide blocking.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/focus_accessibility_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="200" />
