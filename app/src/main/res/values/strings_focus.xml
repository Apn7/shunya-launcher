    <!-- Accessibility disclosure -->
    <string name="focus_a11y_title">Accessibility service</string>
    <string name="focus_a11y_status_on">The service is on.</string>
    <string name="focus_a11y_status_off">The service is off.</string>
    <string name="focus_a11y_intro">Shunya can use Android\'s accessibility service for two things. It stays off until you turn it on, and you can turn it off at any time.</string>
    <string name="focus_a11y_does_header">What it does</string>
    <string name="focus_a11y_does_lock">Locks the screen when you double-tap the home screen (Android 9 and newer).</string>
    <string name="focus_a11y_does_block">With system-wide blocking, shows the pause screen when a blocked app opens from anywhere: notifications, recent apps or links.</string>
    <string name="focus_a11y_sees_header">What Shunya sees</string>
    <string name="focus_a11y_sees_body">Only which app comes to the front, at the moment it does. That is checked against your focus rules and then forgotten.</string>
    <string name="focus_a11y_never_header">What Shunya never does</string>
    <string name="focus_a11y_never_read">It never reads what is on your screen or what you type.</string>
    <string name="focus_a11y_never_store">It never records, keeps or shares anything. Shunya has no internet permission.</string>
    <string name="focus_a11y_never_act">It never taps, types or changes anything in other apps.</string>
    <string name="focus_a11y_control_header">You stay in control</string>
    <string name="focus_a11y_without">Without the service, focus rules only apply to apps you open from Shunya.</string>
    <string name="focus_a11y_steps">In settings, choose “%1$s” and turn it on.</string>
    <string name="focus_a11y_agree">Agree and open settings</string>
    <string name="focus_a11y_manage">Open accessibility settings</string>

    <!-- Grayscale setup -->
    <string name="focus_grayscale_title">Grayscale</string>
    <string name="focus_grayscale_switch_summary">Show the whole screen in black and white. Colour makes apps more tempting.</string>
    <string name="focus_grayscale_ready">Ready: Shunya can turn grayscale on and off.</string>
    <string name="focus_grayscale_needs_setup">Needs a one-time setup from a computer.</string>
    <string name="focus_grayscale_setup_header">One-time setup</string>
    <string name="focus_grayscale_step_1">1. On this phone, turn on Developer options and USB debugging.</string>
    <string name="focus_grayscale_step_2">2. Connect the phone to a computer that has ADB (Android platform-tools) and run:</string>
    <string name="focus_grayscale_step_3">3. Come back here. The switch above works from then on.</string>
    <string name="focus_grayscale_why">Android lets an app change the colour mode only with this permission, and it can only be given over USB. It stays until you uninstall Shunya.</string>
    <string name="focus_grayscale_colour_note">Grayscale uses Android\'s colour correction. If you already use colour correction, your own setting comes back when grayscale is turned off.</string>
    <string name="focus_grayscale_clip_label">ADB command</string>

