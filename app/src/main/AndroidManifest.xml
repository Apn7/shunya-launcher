<?xml version="1.0" encoding="utf-8"?>
<!--
  Shunya manifest for the whole product.
  Every permission is justified on the in-app Permissions screen. No INTERNET permission, by design.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen time, daily limits and "most used" sort. The user grants it in Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Grayscale toggle through secure settings. Granted once over ADB; everything works without it. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Swipe down on home opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" in the app action sheet. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Haptic ticks (long-press, fast scroller). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tapping the clock opens the system alarm list. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Package visibility: every app with a launcher entry, plus the handful of intents we probe. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".ShunyaApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shunya"
        tools:targetApi="36">

        <!-- The home screen. Locale changes deliberately recreate it so every string refreshes. -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|touchscreen|mcc|mnc|colorMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mindful pause / limit / blocked screen. Own task, never in recents or history. -->
        <activity
            android:name=".feature.focus.gate.GateActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|touchscreen|mcc|mnc|colorMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="dev.apn7.shunya.gate"
            android:theme="@style/Theme.Shunya.Gate"
            android:windowSoftInputMode="stateHidden" />

        <!-- Opt-in: lock screen on double-tap and system-wide blocking. -->
        <service
            android:name=".feature.focus.accessibility.ShunyaAccessibilityService"
            android:exported="true"
            android:label="@string/focus_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Opt-in: holds notifications from non-allowed apps in the Inbox. -->
        <service
            android:name=".feature.notifications.NotificationFilterService"
            android:exported="true"
            android:label="@string/notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
